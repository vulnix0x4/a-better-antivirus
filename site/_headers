# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/
#
# The Content-Security-Policy lists exactly what the pages load: their own
# stylesheet, scripts, font, images and video, and nothing from anywhere else.
# There are no inline scripts or styles, so neither needs 'unsafe-inline'. The
# page makes no network requests from script (connect-src 'none'). Anything
# hosted elsewhere is blocked until it is added here, which is the point: ABA
# promises no telemetry and the site keeps to it.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'none'; manifest-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# These only change when they're replaced by hand.
/media/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=2592000
